{
  "opencollection": "1.0.0",
  "info": {
    "name": "SendPulse Account Email Blacklist API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Email Blacklist",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "View blacklisted emails.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sendpulse.com/blacklist"
          },
          "docs": "View blacklisted emails."
        },
        {
          "info": {
            "name": "Add emails to the blacklist.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sendpulse.com/blacklist",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add emails to the blacklist."
        },
        {
          "info": {
            "name": "Remove emails from the blacklist.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.sendpulse.com/blacklist",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Remove emails from the blacklist."
        }
      ]
    }
  ],
  "bundled": true
}