{
  "opencollection": "1.0.0",
  "info": {
    "name": "SendPulse Account API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account balance.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sendpulse.com/balance"
          },
          "docs": "Get account balance."
        }
      ]
    }
  ],
  "bundled": true
}