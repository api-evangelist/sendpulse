{
  "info": {
    "name": "SendPulse API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "REST API for the SendPulse multichannel marketing platform. Authenticated with an OAuth2 client_credentials Bearer token obtained from POST /oauth/access_token. Base URL https://api.sendpulse.com."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.sendpulse.com"
    }
  ],
  "item": [
    {
      "name": "Authorization",
      "item": [
        {
          "name": "Obtain an access token.",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/access_token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "access_token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"client_credentials\",\n  \"client_id\": \"{{clientId}}\",\n  \"client_secret\": \"{{clientSecret}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Obtain an OAuth2 Bearer access token using the client_credentials grant. Tokens are valid for approximately one hour."
          }
        }
      ]
    },
    {
      "name": "Address Books",
      "item": [
        {
          "name": "List address books.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/addressbooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addressbooks"
              ]
            },
            "description": "List address books (mailing lists)."
          }
        },
        {
          "name": "Create an address book.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/addressbooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addressbooks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookName\": \"My List\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Create a new address book."
          }
        },
        {
          "name": "Add emails to an address book.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/addressbooks/:id/emails",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addressbooks",
                ":id",
                "emails"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emails\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Add subscribers (emails with variables) to an address book."
          }
        }
      ]
    },
