{
  "opencollection": "1.0.0",
  "info": {
    "name": "SendPulse Account Senders API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Senders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List email senders.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sendpulse.com/senders"
          },
          "docs": "List email senders."
        },
        {
          "info": {
            "name": "Add an email sender.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sendpulse.com/senders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add an email sender."
        }
      ]
    }
  ],
  "bundled": true
}